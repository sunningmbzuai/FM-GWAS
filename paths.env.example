# Copy to paths.env (git-ignored) and fill in, or export these variables.
# Values already set in the environment take precedence over this file.

# Required
UKBV_OUT_ROOT=            # directory every pipeline output is written under
UKBV_CONDA_ROOT=          # conda root holding wasp_env, microbiome, deep_learning, fmgwas_assoc
UKBV_FMGWAS_ROOT=         # checkout of the FM-GWAS repository (main branch)
UKBV_UKB_BFILE=           # PLINK prefix of the UKB genotyped array calls (GRCh37)
UKBV_QC_FAM=              # .fam listing the QC-passed UKB samples
UKBV_PHENO_DIR=           # directory with ukb676772.parquet and phenotypes_export/
UKBV_GRCH37_FASTA=        # GRCh37 reference FASTA (human_g1k_v37)
UKBV_COMPILED_BINARY=     # portable AIDO.DNA3-AG .pt2 (GPU stage only)

# Optional (defaults shown)
# UKBV_GRCH37_GTF=$UKBV_OUT_ROOT/reference/gencode.v19.annotation.gtf
# UKBV_EAGLE_DIR=$UKBV_OUT_ROOT/eagle_local    # must be local, non-FUSE disk
# UKBV_PLINK2=plink2
